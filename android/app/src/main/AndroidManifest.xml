<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application
    android:allowBackup="false"
    android:icon="@drawable/cutnova_icon"
    android:roundIcon="@drawable/cutnova_icon"
    android:label="@string/app_name"
    android:theme="@android:style/Theme.Translucent.NoTitleBar"
    android:supportsRtl="true">
    <activity
      android:name="com.google.androidbrowserhelper.trusted.LauncherActivity"
      android:exported="true"
      android:label="@string/app_name">
      <meta-data android:name="android.support.customtabs.trusted.DEFAULT_URL" android:value="@string/launch_url"/>
      <meta-data android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR" android:resource="@color/cutnova_black"/>
      <meta-data android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR" android:resource="@color/cutnova_black"/>
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
